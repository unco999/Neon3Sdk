{
  "name": "@neon3/sdk",
  "version": "0.1.1",
  "description": "Node.js and TypeScript SDK for the Neon3 control-plane protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "probe": "npm run build && node dist/examples/api-probe.js",
    "probe:runtime": "npm run build && node dist/bin/runtime-session-probe.js",
    "calculator": "npm run build && node dist/examples/calculator/app.js",
    "calculator:once": "npm run build && node dist/examples/calculator/app.js --once"
  },
  "engines": { "node": ">=18" },
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
